# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
.next/
*.tsbuildinfo

# Environment & secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

