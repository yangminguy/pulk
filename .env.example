# L5 Business OS Environment Configuration

# ============================================
# PostgreSQL (Docker)
# ============================================
POSTGRES_USER=l5_user
POSTGRES_PASSWORD=l5_secure_password
POSTGRES_DB=l5_business_os
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ============================================
# NocoBase Configuration
# ============================================
NOCOBASE_HOST=localhost
NOCOBASE_PORT=8080
DATABASE_URL=postgres://l5_user:l5_secure_password@localhost:5432/l5_business_os

# ============================================
# LLM — OpenAI GPT
# ============================================
OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o   # optional, defaults to gpt-4o

# ============================================
# Mastra Agent Runtime
# ============================================
MASTRA_API_URL=http://localhost:3001
MASTRA_LLM_PROVIDER=openai

# ============================================
# Trigger.dev (Hermes Runtime)
# ============================================
TRIGGER_DEV_API_URL=http://localhost:3030
TRIGGER_DEV_API_KEY=optional_for_local

# ============================================
# Langfuse (LLM Observability)
# ============================================
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=http://localhost:8081

# ============================================
# Formbricks (PMF Signal Collection)
# ============================================
FORMBRICKS_ENABLED=false
FORMBRICKS_ENVIRONMENT_ID=your_environment_id
FORMBRICKS_API_KEY=your_formbricks_api_key

# ============================================
# Activepieces (External Automation)
# ============================================
ACTIVEPIECES_ENABLED=false
ACTIVEPIECES_API_URL=http://localhost:3000
ACTIVEPIECES_TOKEN=optional_for_local

# ============================================
# Slack Integration (for notifications)
# ============================================
SLACK_BOT_TOKEN=optional_for_notifications
SLACK_WEBHOOK_URL=optional_for_notifications

# ============================================
# Telegram Gateway (inbound @executive commands)
# ============================================
# Bot token from @BotFather. Used for BOTH outbound notifications (hermes) and
# inbound commands (telegram-gateway).
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Chat id allowed to issue commands. Comma-separate for multiple, or use
# TELEGRAM_ALLOWED_CHAT_IDS. Messages from any other chat are ignored.
TELEGRAM_CHAT_ID=your_chat_id
# TELEGRAM_ALLOWED_CHAT_IDS=12345,67890
# pulk repo root (defaults to the build location's repo root if unset).
# PULK_DIR=/Users/you/Desktop/pulk
# Model for headless executive runs (sonnet|opus|haiku).
TELEGRAM_AGENT_MODEL=sonnet
# Extra claude CLI args. Default lets agents write files; for full autonomy
# (bash/video render) use: --dangerously-skip-permissions
TELEGRAM_CLAUDE_ARGS=--permission-mode acceptEdits
# Max wall-clock per executive run (ms). Default 15 min.
TELEGRAM_RUN_TIMEOUT_MS=900000
# CLAUDE_BIN=/opt/homebrew/bin/claude

# ============================================
# Application Configuration
# ============================================
NODE_ENV=development
LOG_LEVEL=debug
ENABLE_MOCK_LLM=true
