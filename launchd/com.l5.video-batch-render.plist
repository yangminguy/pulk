             배포 시 ~/Library/LaunchAgents 복사본에 PlistBuddy로 주입:
             /usr/libexec/PlistBuddy -c "Add :EnvironmentVariables:NOCOBASE_TOKEN string <TOKEN>" ... -->
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>StandardOutPath</key>
    <string>/Users/wonminyang/.l5/video-batch-render/daemon.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/wonminyang/.l5/video-batch-render/daemon.err.log</string>
</dict>
</plist>
