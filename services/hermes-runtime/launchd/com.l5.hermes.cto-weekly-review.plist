<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.l5.hermes.cto-weekly-review</string>

  <key>ProgramArguments</key>
  <array>
    <string>__NODE_PATH__</string>
    <string>__HERMES_DIR__/dist/gateway.js</string>
    <string>cto-weekly-review</string>
  </array>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>1</integer>
    <key>Hour</key>
    <integer>10</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <key>EnvironmentVariables</key>
  <dict>
    <key>NOCOBASE_URL</key>
    <string>http://localhost:13000</string>
    <key>ACR_BASE_URL</key>
    <string>http://localhost:3001</string>
  </dict>

  <key>StandardOutPath</key>
  <string>__LOG_DIR__/cto-weekly-review.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/cto-weekly-review.err</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
