<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.l5.hermes.task-dispatcher</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE_PATH__</string>
    <string>__HERMES_DIR__/dist/gateway.js</string>
    <string>task-dispatcher</string>
  </array>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>WorkingDirectory</key>
  <string>__HERMES_DIR__</string>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/task-dispatcher.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/task-dispatcher.err</string>
  <key>RunAtLoad</key>
  <false/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>NODE_ENV</key>
    <string>production</string>
    <!-- cto.ts loadQuotaState가 읽는 쿼터 트래커 경로. ACR(acr-web)가 같은 경로에 write.
         양쪽 env가 같아야 쿼터 인지 라우팅이 동작(미설정 시 graceful=전 tier 가용). -->
    <key>ACR_QUOTA_TRACKER_PATH</key>
    <string>/Users/wonminyang/l5-workspace/acr-quota-tracker.json</string>
  </dict>
</dict>
</plist>
