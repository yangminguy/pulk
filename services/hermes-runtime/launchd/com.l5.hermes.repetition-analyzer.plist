<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.l5.hermes.repetition-analyzer</string>

  <key>ProgramArguments</key>
  <array>
    <string>__NODE_PATH__</string>
    <string>__HERMES_DIR__/dist/gateway.js</string>
    <string>repetition-analyzer</string>
  </array>

  <key>StartInterval</key>
  <integer>7200</integer>

  <key>EnvironmentVariables</key>
  <dict>
    <key>NOCOBASE_URL</key>
    <string>http://localhost:13000</string>
    <key>ACR_BASE_URL</key>
    <string>http://localhost:3001</string>
  </dict>

  <key>StandardOutPath</key>
  <string>__LOG_DIR__/repetition-analyzer.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/repetition-analyzer.err</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
