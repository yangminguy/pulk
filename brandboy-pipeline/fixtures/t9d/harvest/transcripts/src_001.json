{
  "source_id": "src_001",
  "segments": [
    { "start": 0.0, "end": 0.3, "text": "브랜드보이가 새로운 광고를 공개했습니다" },
    { "start": 0.3, "end": 0.6, "text": "매출이 크게 늘었습니다" },
    { "start": 0.6, "end": 0.9, "text": "그 광고는 1988년에 처음 나왔습니다" },
    { "start": 0.9, "end": 1.2, "text": "많은 사람들이 아직도 그것을 기억합니다" },
    { "start": 1.2, "end": 1.5, "text": "결국 그 브랜드는 크게 성장했습니다" },
    { "start": 1.5, "end": 1.8, "text": "그것이 우리가 배운 교훈입니다" }
  ]
}
